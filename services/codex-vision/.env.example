# Generate a unique secret with: openssl rand -hex 32
EKPHRASIS_AGENT_SECRET=replace-with-a-random-secret

CODEX_BIN=/usr/local/bin/codex
CODEX_TIMEOUT_SECONDS=240
# Optional Codex CLI settings:
CODEX_MODEL=
CODEX_PROFILE=

# Dedicated service-account paths. Create them and grant access to ekphrasis.
CODEX_HOME=/home/ekphrasis/.codex
CODEX_WORK_ROOT=/home/ekphrasis/work
XDG_CACHE_HOME=/home/ekphrasis/.cache
