# Generate a unique secret with: openssl rand -hex 32
EKPHRASIS_AGENT_SECRET=replace-with-a-random-secret

CODEX_BIN=/usr/local/bin/codex
CODEX_TIMEOUT_SECONDS=240
# Optional Codex CLI settings:
CODEX_MODEL=
CODEX_PROFILE=

# This deployment reuses DomainPatrol's authenticated Codex profile.
HOME=/opt/domainpatrol
CODEX_HOME=/opt/domainpatrol/.codex
CODEX_WORK_ROOT=/opt/domainpatrol/ekphrasis-repair/work
XDG_CACHE_HOME=/opt/domainpatrol/.codex/cache
