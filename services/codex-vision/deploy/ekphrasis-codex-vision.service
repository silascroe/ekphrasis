[Unit]
Description=Ekphrasis Codex Vision Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=domainpatrol
Group=domainpatrol
WorkingDirectory=/opt/domainpatrol/ekphrasis-repair
EnvironmentFile=/etc/ekphrasis-repair.env
Environment=HOME=/opt/domainpatrol
Environment=CODEX_HOME=/opt/domainpatrol/.codex
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/domainpatrol/ekphrasis-repair/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8787 --workers 1
Restart=on-failure
RestartSec=5
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/opt/domainpatrol/.codex /opt/domainpatrol/ekphrasis-repair/work

[Install]
WantedBy=multi-user.target
